# ---------------------------------------------------------------------------
# home-intercom environment
# Copy to .env for local dev.  Never commit real secrets.
# ---------------------------------------------------------------------------

# Postgres (control plane: devices, zones, reminders, audit log).
#
# Local docker-compose:
#   DATABASE_URL="postgresql://intercom:intercom@localhost:5432/intercom?schema=public"
#
# Neon (production): use the POOLED connection (has `-pooler` in the host) for
# the app, with pgbouncer=true so Prisma disables prepared statements; use the
# DIRECT (unpooled) connection for migrations. Get both from the Neon console.
DATABASE_URL="postgresql://USER:PASS@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASS@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# LiveKit (media + control transport). These match docker-compose defaults.
# In production generate strong values and keep them out of git.
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="devsecret_change_me_at_least_32_chars_long"

# Public URL the browser uses to reach LiveKit (may differ from server-side
# LIVEKIT_URL when behind a tunnel). Falls back to LIVEKIT_URL if unset.
NEXT_PUBLIC_LIVEKIT_URL="ws://localhost:7880"

# Web push (VAPID) for waking backgrounded/remote devices. Generate with
# `npx web-push generate-vapid-keys`. Optional until Phase 4.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Local TTS (Piper) endpoint on the home server. Optional offline alternative;
# text announce prefers OpenAI Ash when configured below.
PIPER_TTS_URL="http://localhost:5000"

# Anthropic API key — powers AI reminders ("remind Willoughby at 4pm tomorrow").
# Without it, /api/reminders/parse returns a 503 and manual reminders still work.
ANTHROPIC_API_KEY=""

# OpenAI — Ash neural TTS for Broadcast "Say something" announces.
# Also set BLOB_READ_WRITE_TOKEN (Vercel Blob) so mp3 clips are fetchable by endpoints.
# Without either, announces still deliver as text and use on-device SpeechSynthesis.
OPENAI_API_KEY=""
BLOB_READ_WRITE_TOKEN=""

# Reminder scheduler: Vercel Cron hits /api/cron/tick every minute. Set this on
# Vercel and the cron route requires it (Authorization: Bearer <secret>).
# Leave blank locally to run the tick without auth.
# REQUIRED in production: the cron tick fails closed without it, because an
# unset secret used to mean "open" and Vercel stores empty strings. Generate
# with `openssl rand -hex 32`. Leave empty for local dev.
CRON_SECRET=""

# Dev toggle: when "1"/"true", the app fakes LiveKit + TTS + push so it runs
# on a laptop with no home server. Mirrors inChambers' MOCK_LOCAL_SERVICES.
MOCK_LOCAL_SERVICES="true"

# Weather for the Hub. Open-Meteo needs no key and no account, so weather works
# out of the box; these three just move it off Sydney.
WEATHER_LATITUDE="-33.8688"
WEATHER_LONGITUDE="151.2093"
WEATHER_PLACE="Sydney"

# Apple Music (MusicKit) — the Hub's Music screen.
# All three come from the Apple Developer portal and require a paid Apple
# Developer Program membership: create a MusicKit identifier, then a MusicKit
# private key, which downloads once as a .p8 file.
#   APPLE_MUSIC_TEAM_ID     your 10-character Apple Developer team ID
#   APPLE_MUSIC_KEY_ID      the 10-character Key ID shown beside the .p8
#   APPLE_MUSIC_PRIVATE_KEY the .p8 contents, newlines written as \n
# Playing full tracks also needs an Apple Music subscription on the account that
# signs in at the Hub. Leave these blank and the Music screen says it is not set
# up rather than showing a player that cannot play.
APPLE_MUSIC_TEAM_ID=""
APPLE_MUSIC_KEY_ID=""
APPLE_MUSIC_PRIVATE_KEY=""
