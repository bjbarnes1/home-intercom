# ---------------------------------------------------------------------------
# home-intercom environment
# Copy to .env for local dev.  Never commit real secrets.
# ---------------------------------------------------------------------------

# Postgres (control plane: devices, zones, reminders, audit log)
DATABASE_URL="postgresql://intercom:intercom@localhost:5432/intercom?schema=public"

# LiveKit (media + control transport). These match docker-compose defaults.
# In production generate strong values and keep them out of git.
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="devsecret_change_me_at_least_32_chars_long"

# Public URL the browser uses to reach LiveKit (may differ from server-side
# LIVEKIT_URL when behind a tunnel). Falls back to LIVEKIT_URL if unset.
NEXT_PUBLIC_LIVEKIT_URL="ws://localhost:7880"

# Web push (VAPID) for waking backgrounded/remote devices. Generate with
# `npx web-push generate-vapid-keys`. Optional until Phase 4.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Local TTS (Piper) endpoint on the home server. Optional until Phase 3.
PIPER_TTS_URL="http://localhost:5000"

# Dev toggle: when "1"/"true", the app fakes LiveKit + TTS + push so it runs
# on a laptop with no home server. Mirrors inChambers' MOCK_LOCAL_SERVICES.
MOCK_LOCAL_SERVICES="true"
