// home-intercom control-plane data model.
// Postgres for concurrent writers (many endpoints) + a durable scheduler.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection for the app runtime (PgBouncer).
  url = env("DATABASE_URL")
  // Direct (unpooled) connection for migrations. On Neon this is the same host
  // without the `-pooler` suffix. Falls back to DATABASE_URL if unset.
  directUrl = env("DIRECT_URL")
}

/// A household groups all users, devices and zones. Multi-tenant-ready even
/// though we run a single home today.
model Household {
  id        String   @id @default(cuid())
  name      String
  /// IANA timezone for day boundaries (chore days, quiet hours, etc.).
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  devices   Device[]
  zones     Zone[]
  reminders Reminder[]
  events    IntercomEvent[]
  kids      Kid[]
  chores    Chore[]
  calendarEvents CalendarEvent[]
  music     MusicState?
  places    Place[]
  placeRules PlaceRule[]
  roomBeacons RoomBeacon[]
}

/// Shared, household-wide music player state. Demo-backed today (a fixed
/// playlist); the same shape can front a real source (Spotify/Sonos) later.
model MusicState {
  householdId String   @id
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  source      String   @default("Household")
  trackIndex  Int      @default(0)
  isPlaying   Boolean  @default(false)
  rooms       String[] // device ids the music is playing on
  updatedAt   DateTime @updatedAt
}

/// A shared calendar entry shown on the wall panel's Schedule surface.
model CalendarEvent {
  id          String   @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  title       String
  startsAt    DateTime
  endsAt      DateTime?
  allDay      Boolean  @default(false)
  who         String? // free-text owner label, e.g. "Gus", "Family"
  location    String?
  color       String? // hex accent for the event's rail
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([householdId, startsAt])
}

/// A child in the household. Distinct from their room's Device — a kid may have
/// no device, or more than one. Used for the jobs / chore board.
model Kid {
  id          String    @id @default(cuid())
  householdId String
  household   Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  chores            Chore[]
  assignedReminders Reminder[]

  @@index([householdId])
}

/// A recurring (daily) chore assigned to a kid.
model Chore {
  id          String   @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  kidId       String
  kid         Kid       @relation(fields: [kidId], references: [id], onDelete: Cascade)
  label       String
  order       Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  completions ChoreCompletion[]

  @@index([householdId])
  @@index([kidId])
}

/// A chore ticked done on a particular local day (yyyy-mm-dd).
model ChoreCompletion {
  id          String   @id @default(cuid())
  choreId     String
  chore       Chore    @relation(fields: [choreId], references: [id], onDelete: Cascade)
  day         String // yyyy-mm-dd in the household timezone
  completedAt DateTime @default(now())

  @@unique([choreId, day])
  @@index([choreId])
}

enum UserRole {
  ADMIN // parents
  MEMBER // children / limited
}

model User {
  id          String   @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String
  email       String?  @unique
  role        UserRole @default(MEMBER)
  // scrypt password hash (salt:hash). Null until a password is set — children
  // (MEMBER) need not have one; controllers require it.
  passwordHash String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  devices          Device[]
  initiatedEvents  IntercomEvent[] @relation("EventInitiator")
  createdReminders  Reminder[]     @relation("ReminderCreatedBy")
  assignedReminders Reminder[]     @relation("ReminderAssignee")
  sessions         Session[]
  locationPings    LocationPing[]
  placeVisits      PlaceVisit[]
  locationShare    LocationShare?
  placeRuleSubjects PlaceRule[]    @relation("PlaceRuleSubject")
  placeRuleFires    PlaceRuleFire[] @relation("PlaceRuleFireUser")
  roomFix           RoomFix?

  /// Move the music to whichever room this person walks into.
  followMeMusic Boolean @default(false)

  @@index([householdId])
}

/// Server-side session. The cookie holds an opaque token; only its SHA-256
/// hash is stored here, so a database leak does not expose live sessions.
model Session {
  id        String   @id // sha256(token), hex
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum DeviceType {
  ENDPOINT // fixed station in a room (kiosk phone, future touchscreen)
  CONTROLLER // a parent's phone that initiates
}

enum PairingState {
  PENDING // pairing code issued, not yet claimed
  ACTIVE // paired and trusted
  REVOKED // token rotated / device retired
}

model Device {
  id          String   @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  displayName String
  room        String? // human room label, e.g. "Ada's room", "Lounge"
  type        DeviceType   @default(ENDPOINT)
  pairing     PairingState @default(PENDING)

  // Capabilities advertised by the endpoint (mic/speaker/screen).
  hasMic     Boolean @default(true)
  hasSpeaker Boolean @default(true)
  hasScreen  Boolean @default(true)

  // Per-device etiquette / behaviour.
  doNotDisturb Boolean @default(false)
  autoAnswer   Boolean @default(true) // pages auto-open on endpoints
  /// Soft chime before announce/reminder speech on this panel.
  chimeEnabled Boolean @default(true)

  /// When an Apple Music account was last linked on this panel. The listener's
  /// token stays on the device; this only records that music can land here, so
  /// another panel knows whether a handoff has anywhere to go.
  musicLinkedAt DateTime?

  /// Apple Music on this panel plays clean versions only, and explicit songs
  /// are hidden and skipped. Set by a parent from the controller, never by the
  /// panel itself: a child standing at the panel must not be able to lift it.
  musicCleanOnly Boolean @default(false)

  /// What this panel is playing right now, so other panels can say so. Title
  /// and artist only — enough for a line on a screen, not a listening history.
  nowPlayingTitle  String?
  nowPlayingArtist String?
  /// When that was last reported. Stale means the panel stopped talking, not
  /// that it is still playing.
  nowPlayingAt     DateTime?

  /// The BLE beacon marking this panel's room, if one has been placed.
  roomBeacon RoomBeacon?
  /// Seconds to keep announce/reminder overlay visible before auto-return (default 30).
  announceDwellSec Int @default(30)
  /// When enabled, reminders whisper (no chime, lower volume); pages still ring.
  quietHoursEnabled Boolean @default(false)
  /// Minutes from local midnight (0–1439). Window may wrap past midnight.
  quietHoursStart Int?
  quietHoursEnd   Int?
  /// Endpoint advertises physical front/rear LED bars.
  hasLeds Boolean @default(false)

  // Pairing + presence.
  pairingCode     String?   @unique // short code, cleared once ACTIVE
  deviceSecret    String    @unique // long-lived per-device secret (rotatable)
  lastSeenAt      DateTime?
  pushSubscription Json?    // web-push subscription object

  ownerUserId String?
  ownerUser   User?   @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zoneMemberships ZoneMembership[]
  reminders       Reminder[]
  placeRules      PlaceRule[]
  events          IntercomEvent[] @relation("EventTargetDevice")

  @@index([householdId])
  @@index([householdId, pairing])
}

/// A named set of devices: "Kids", "Downstairs", "All", "Lounge".
model Zone {
  id          String   @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships ZoneMembership[]
  reminders   Reminder[]
  placeRules  PlaceRule[]
  events      IntercomEvent[] @relation("EventTargetZone")

  @@unique([householdId, name])
  @@index([householdId])
}

model ZoneMembership {
  zoneId   String
  zone     Zone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([zoneId, deviceId])
  @@index([deviceId])
}

enum ReminderKind {
  RECURRING // structured `recurrence` rule (preferred) or legacy cron expression
  ONE_OFF // single runAt
}

/// Lifecycle of a reminder occurrence. On `Reminder` it mirrors the current
/// occurrence (one-offs) or the series (recurring stays PENDING while live).
/// Transition table: src/lib/reminders/lifecycle.ts.
enum ReminderStatus {
  PENDING
  SNOOZED
  COMPLETED
  DISMISSED
}

model Reminder {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  /// Title: what is shown large and spoken aloud.
  text    String
  /// Optional context / description shown under the title.
  details String?
  sound   String? // chime name to play before speaking

  kind       ReminderKind @default(ONE_OFF)
  /// RECURRING: structured RecurrenceRule JSON (src/lib/reminders/recurrence.ts).
  /// Takes precedence over `cron`, which is kept for rows created before it.
  recurrence Json?
  // Legacy RECURRING: a 5-field cron expression. For ONE_OFF: runAt is set.
  cron       String?
  runAt      DateTime?
  // IANA timezone the recurrence/cron/runAt is interpreted in (defaults to home TZ).
  timezone   String       @default("UTC")

  enabled      Boolean        @default(true)
  status       ReminderStatus @default(PENDING)
  nextRunAt    DateTime? // materialised by the scheduler: the next *series* slot
  lastRunAt    DateTime?
  /// Deprecated: snooze lives on ReminderOccurrence now. Kept for old rows.
  snoozedUntil DateTime?

  /// Who the reminder is for: at most one of a signed-in member or a kid
  /// (CHECK constraint in migration 13). Collapses to one person FK when the
  /// Kid/User identity migration lands.
  assigneeUserId String?
  assigneeUser   User?   @relation("ReminderAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  assigneeKidId  String?
  assigneeKid    Kid?    @relation(fields: [assigneeKidId], references: [id], onDelete: SetNull)

  // Target (where it rings): exactly one of device or zone.
  targetDeviceId String?
  targetDevice   Device? @relation(fields: [targetDeviceId], references: [id], onDelete: Cascade)
  targetZoneId   String?
  targetZone     Zone?   @relation(fields: [targetZoneId], references: [id], onDelete: Cascade)

  createdByUserId String?
  createdBy       User?   @relation("ReminderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  occurrences ReminderOccurrence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
  @@index([enabled, nextRunAt]) // scheduler poll
}

/// One firing of a reminder: the thing the family acts on. A recurring
/// reminder gets one row per slot. Snoozing re-fires the *same* row, so a
/// snooze never shifts or skips the series.
model ReminderOccurrence {
  id          String   @id @default(cuid())
  reminderId  String
  reminder    Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  /// Denormalised so tenant-scoped reads need no join.
  householdId String

  /// The series slot this occurrence belongs to (Reminder.nextRunAt at fire).
  scheduledFor DateTime
  /// Last time it was surfaced on a panel (first fire or snooze re-fire).
  firedAt      DateTime?
  fireCount    Int       @default(0)

  status       ReminderStatus @default(PENDING)
  snoozedUntil DateTime?
  snoozeCount  Int            @default(0)

  resolvedAt         DateTime?
  /// 'user' | 'superseded' | 'expired' | 'missed'
  resolution         String?
  resolvedByDeviceId String?
  resolvedByUserId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Idempotency: a slot can only ever become one occurrence, so overlapping
  /// scheduler ticks (Vercel cron + an in-process scheduler) cannot double-fire.
  @@unique([reminderId, scheduledFor])
  @@index([status, snoozedUntil]) // snooze re-fire poll
  @@index([householdId, status])
}

enum EventType {
  PAGE
  CALL
  BROADCAST
  ANNOUNCE
  REMINDER
}

enum EventOutcome {
  INITIATED
  DELIVERED
  MISSED // target offline
  ENDED
}

/// Audit log of every page / call / broadcast / reminder fired.
/// No audio is recorded by default — optional summary holds announce text etc.
model IntercomEvent {
  id          String   @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  type    EventType
  outcome EventOutcome @default(INITIATED)
  roomName String? // LiveKit room, when applicable
  /// Short human-readable body (announce text, reminder text, or label).
  summary String?

  initiatorUserId String?
  initiator       User?   @relation("EventInitiator", fields: [initiatorUserId], references: [id], onDelete: SetNull)

  targetDeviceId String?
  targetDevice   Device? @relation("EventTargetDevice", fields: [targetDeviceId], references: [id], onDelete: SetNull)
  targetZoneId   String?
  targetZone     Zone?   @relation("EventTargetZone", fields: [targetZoneId], references: [id], onDelete: SetNull)

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([householdId, startedAt])
}

// ---------------------------------------------------------------------------
// Location & presence. Design note: docs/LOCATION.md
//
// Two rules shape these models, and both are deliberate:
//
//   Symmetric — everyone in the household sees the same map, children included.
//   Asymmetric visibility is what makes this class of app feel like
//   surveillance to the people inside it.
//
//   Short-lived — a leaked intercom log says who paged whom; a leaked location
//   history says where a child was every day for years. History is coarsened
//   after a day and deleted after a week (src/lib/location/retention.ts).
// ---------------------------------------------------------------------------

/// A named geofence: home, school, work, netball. Household-wide rather than
/// per-person, because iOS monitors at most 20 regions *per app* — that budget
/// is shared by everyone, so the places must be too.
model Place {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String
  lat         Float
  lng         Float
  /// Geofence radius in metres. iOS quietly clamps very small radii, and GPS
  /// scatter near buildings is tens of metres, so the floor here is generous.
  radiusM     Int       @default(150)
  /// Icon hint for the UI (an SF Symbol name on iOS).
  icon        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  visits PlaceVisit[]
  rules  PlaceRule[]

  @@index([householdId])
}

/// One location fix reported by a phone. Only the most recent fix per person is
/// shown on the map; older rows exist so "left home at 8:15" can be answered,
/// and are coarsened then pruned on a schedule.
model LocationPing {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  accuracyM  Float?
  /// So the map can say "Raff's phone is on 4%" — the thing you actually want
  /// to know when someone isn't where you expected.
  batteryPct Int?
  /// Which sensor produced it: "significant", "region" or "manual".
  source     String   @default("significant")
  /// Set once retention has rounded this row to ~100m, so the UI never implies
  /// a precision the row no longer has.
  coarse     Boolean  @default(false)
  capturedAt DateTime
  createdAt  DateTime @default(now())

  @@index([userId, capturedAt])
  @@index([capturedAt])
}

/// An arrival at (and later departure from) a Place. Computed on the phone by
/// Core Location, which is why the server never needs a stream of raw fixes to
/// know someone got home.
model PlaceVisit {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId   String
  place     Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)
  arrivedAt DateTime
  leftAt    DateTime?

  @@index([userId, arrivedAt])
  @@index([placeId, leftAt])
}

enum LocationShareMode {
  /// Nothing is reported, and the phone stops monitoring entirely.
  OFF
  /// Arrivals and departures, plus a coarse last-known position.
  PLACES
  /// High-accuracy and time-boxed. Reserved — not implemented yet.
  LIVE
}

/// Consent as a first-class record, not an implicit consequence of having the
/// app installed. Every household member can read every row, so "who is
/// sharing" is never a hidden state.
model LocationShare {
  userId    String            @id
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode      LocationShareMode @default(OFF)
  /// When LIVE expires. Enforced server-side so a phone that goes offline
  /// mid-share cannot keep broadcasting precise positions.
  liveUntil DateTime?
  updatedAt DateTime          @updatedAt
}

enum PlaceTrigger {
  ARRIVE
  DEPART
}

/// "When Willoughby arrives Home, say *Willoughby's home* in the Kitchen."
///
/// The crossover an off-the-shelf tracker can't do: a geofence event is already
/// on the server, and so is a house full of speakers. `{name}` and `{place}` in
/// the template are substituted when it fires.
model PlaceRule {
  id          String       @id @default(cuid())
  householdId String
  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  placeId     String
  place       Place        @relation(fields: [placeId], references: [id], onDelete: Cascade)
  trigger     PlaceTrigger

  /// Null means anyone in the household — "when *anyone* gets home".
  subjectUserId String?
  subject       User?   @relation("PlaceRuleSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)

  /// Spoken text. Supports {name} and {place}.
  template String

  /// Exactly one target, same rule as reminders and announcements.
  targetDeviceId String?
  targetDevice   Device? @relation(fields: [targetDeviceId], references: [id], onDelete: Cascade)
  targetZoneId   String?
  targetZone     Zone?   @relation(fields: [targetZoneId], references: [id], onDelete: Cascade)

  enabled Boolean @default(true)

  /// Minimum gap between fires for the same person. A phone sitting on the
  /// geofence boundary can cross it repeatedly, and a house that announces
  /// "Willoughby's home" five times gets the feature switched off.
  cooldownMinutes Int @default(15)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fires PlaceRuleFire[]

  @@index([householdId])
  @@index([placeId, trigger, enabled])
}

/// When a rule last spoke for a given person, so the cooldown has something to
/// measure against. One row per rule per person, overwritten each time.
model PlaceRuleFire {
  id      String    @id @default(cuid())
  ruleId  String
  rule    PlaceRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  userId  String
  user    User      @relation("PlaceRuleFireUser", fields: [userId], references: [id], onDelete: Cascade)
  firedAt DateTime

  @@unique([ruleId, userId])
}

/// A BLE beacon marking one room, so a phone that hears it knows where it is.
///
/// Identified the iBeacon way — one UUID for the household, major/minor per
/// room — because that is what iOS can monitor in the background, which is the
/// only way "follow me" works with a phone in a pocket.
model RoomBeacon {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  /// Human name for the room, e.g. "Kitchen".
  label String
  uuid  String
  major Int
  minor Int

  /// The panel in this room. Null while a beacon is placed but no panel is.
  deviceId String? @unique
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  fixes     RoomFix[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([householdId, uuid, major, minor])
  @@index([householdId])
}

/// Where we currently believe someone is, and since when.
///
/// One row per person rather than a history: this answers "where are they now",
/// and keeping every sighting would be a movement log of a family's home, which
/// is not something worth storing to move some music.
model RoomFix {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  beaconId String?
  beacon   RoomBeacon? @relation(fields: [beaconId], references: [id], onDelete: SetNull)

  /// When they arrived in this room.
  since     DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([beaconId])
}
